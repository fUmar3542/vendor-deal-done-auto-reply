# ---------- Mailbox (required) ----------
EMAIL_ADDRESS=info@rankzeek.com
EMAIL_PASSWORD=pass
IMAP_HOST=premium152.web-hosting.com
IMAP_PORT=993
SMTP_HOST=premium152.web-hosting.com
SMTP_PORT=465
SENT_FOLDER=INBOX.Sent
SENDER_NAME=Sophia William

# ---------- Negotiation ----------
OPEN_PRICE=10
MAX_PRICE=20
MAX_SENDS_PER_DAY=100
PAYMENT_METHODS=PayPal, Wise, Payoneer
# Auto-Submitted header on replies (1 = add it, 0 = don't)
AUTO_SUBMITTED_HEADER=0

# ---------- Timing ----------
ONLY_SINCE_DAYS=14

# ---------- AI providers (order = priority) ----------
AI_PROVIDER_ORDER=groq

# Multiple keys per provider: separate with commas, no spaces needed
GROQ_API_KEYS=key
GROQ_MODEL=openai/gpt-oss-120b

REPLY_DELAY_MIN_MINUTES=1
REPLY_DELAY_MAX_MINUTES=4
DELAY_MIN_SECONDS=5
DELAY_MAX_SECONDS=20
MAX_REPLIES_PER_VENDOR=30
MAX_CLARIFY=10